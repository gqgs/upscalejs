{
  "name": "upscalejs",
  "version": "2.1.0",
  "files": [
    "dist/upscalejs.es.js",
    "dist/*.d.ts",
    "dist/js",
    "dist/models"
  ],
  "type": "module",
  "types": "./dist/worker.d.ts",
  "description": "Upscale images using super resolution AI models",
  "browser": "./dist/upscalejs.es.js",
  "module": "./dist/upscalejs.es.js",
  "main": "./dist/upscalejs.es.js",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/upscalejs.es.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lib": "vue-tsc -p tsconfig.lib.json --noEmit && vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.lib.json -d --emitDeclarationOnly --outDir dist",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "predev": "node scripts/sync-ort-assets.mjs",
    "prebuild": "node scripts/sync-ort-assets.mjs",
    "prelib": "node scripts/sync-ort-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "keywords": [
    "image",
    "upscale",
    "ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gqgs/upscalejs.git"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@types/node": "^22.0.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^2.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.13"
  }
}
